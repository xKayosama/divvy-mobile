{
  "expo": {
    "name": "Divvy",
    "slug": "divvy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/divvy-icon-green.png",
    "scheme": "divvymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/divvy-icon-green.png"
      },
      "bundleIdentifier": "com.kayosama.divvy-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/divvy-icon-green.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/divvy-icon-green.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F8F6",
          "image": "./assets/images/divvy-icon-green.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0C1512",
            "image": "./assets/images/divvy-icon-green.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Divvy to select receipt photos for expense scanning.",
          "cameraPermission": "Allow Divvy to photograph receipts for expense scanning.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
